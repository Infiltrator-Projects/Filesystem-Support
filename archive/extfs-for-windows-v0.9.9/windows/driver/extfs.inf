; SPDX-License-Identifier: GPL-3.0-or-later
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 08/20/2026,0.9.3.0
CatalogFile = extfs.cat
PnpLockdown = 1

[DestinationDirs]
ExtFS.DriverFiles = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
extfs.sys = 1

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = ExtFS.DriverFiles

[DefaultInstall.NTarm64]
OptionDesc = %ServiceDescription%
CopyFiles  = ExtFS.DriverFiles

[ExtFS.DriverFiles]
extfs.sys

[DefaultInstall.NTamd64.Services]
AddService = ExtFS,,ExtFS.Service

[DefaultInstall.NTarm64.Services]
AddService = ExtFS,,ExtFS.Service

[ExtFS.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %13%\extfs.sys
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "File System"

[Strings]
ProviderName       = "Shannon Smith"
DiskName           = "Ext Filesystem Driver installation media"
ServiceName        = "ExtFS"
ServiceDescription = "Experimental native ext2/ext3/ext4 filesystem driver with bounded ext2/ext3/ext4 file resize"
