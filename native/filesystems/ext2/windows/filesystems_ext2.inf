; SPDX-License-Identifier: GPL-3.0-or-later
[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
DriverVer   = 09/23/2026,0.4.2.0
CatalogFile = filesystems_ext2.cat
PnpLockdown = 1

[DestinationDirs]
FsExt2.DriverFiles = 13

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
filesystems_ext2.sys = 1

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = FsExt2.DriverFiles

[DefaultInstall.NTarm64]
OptionDesc = %ServiceDescription%
CopyFiles  = FsExt2.DriverFiles

[FsExt2.DriverFiles]
filesystems_ext2.sys

[DefaultInstall.NTamd64.Services]
AddService = FilesystemsExt2,,FsExt2.Service

[DefaultInstall.NTarm64.Services]
AddService = FilesystemsExt2,,FsExt2.Service

[FsExt2.Service]
DisplayName    = %ServiceName%
Description    = %ServiceDescription%
ServiceBinary  = %13%\filesystems_ext2.sys
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "File System"

[Strings]
ProviderName       = "Infiltrator Projects"
DiskName           = "Filesystems EXT2 driver installation media"
ServiceName        = "Filesystems EXT2"
ServiceDescription = "Native Windows EXT2 adapter using the canonical Filesystems EXT2 engine"
