# SPDX-License-Identifier: GPL-3.0-or-later
#
# Publish identity only for installed native Amiga formats before the standard
# persistent-storage rules run. util-linux/libblkid does not identify these
# filesystems, so fsinspect supplies the ID_FS_* properties that UDisks and
# desktop tools expect. The helper is bounded, read-only and uses the same
# canonical format validators as the kernel modules. Each format also requires
# its own project-native .ko for the running kernel; one driver never enables
# desktop recognition of another Amiga format.

# Clear stale properties when media previously identified by this rule is
# changed or reformatted. A still-valid volume is repopulated immediately by
# the IMPORT rule below.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="ofs",  ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="ffs",  ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="sfs",  ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="sfs2", ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="pfs3", ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""

ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", IMPORT{program}="/usr/bin/fsinspect --udev /dev/%k"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk",      IMPORT{program}="/usr/bin/fsinspect --udev /dev/%k"

# Ensure the matching project-native filesystem is registered before UDisks
# evaluates a mount request.
ENV{ID_FS_TYPE}=="ofs",  RUN+="/sbin/modprobe -q ofs"
ENV{ID_FS_TYPE}=="ffs",  RUN+="/sbin/modprobe -q ffs"
ENV{ID_FS_TYPE}=="sfs",  RUN+="/sbin/modprobe -q sfs"
ENV{ID_FS_TYPE}=="sfs2", RUN+="/sbin/modprobe -q sfs2"
ENV{ID_FS_TYPE}=="pfs3", RUN+="/sbin/modprobe -q pfs3"

# Give UDisks/GVfs useful device hint names without replacing a real volume
# label. The managed UDisks client package separately supplies GNOME Disks'
# filesystem descriptions in Contents and the volume map.
ENV{ID_FS_TYPE}=="ofs",  ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga OFS"
ENV{ID_FS_TYPE}=="ffs",  ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga FFS"
ENV{ID_FS_TYPE}=="sfs",  ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga SFS"
ENV{ID_FS_TYPE}=="sfs2", ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga SFS2"
ENV{ID_FS_TYPE}=="pfs3", ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga PFS3"
ENV{ID_FS_TYPE}=="ofs|ffs|sfs|sfs2|pfs3", ENV{UDISKS_ICON_NAME}="drive-harddisk"
ENV{ID_FS_TYPE}=="ofs|ffs|sfs|sfs2|pfs3", ENV{UDISKS_SYMBOLIC_ICON_NAME}="drive-harddisk-symbolic"

# Generic VFS-safe desktop mount policy. PFS3 remains intentionally read-only.
ENV{ID_FS_TYPE}=="ofs|ffs|sfs|sfs2", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="nodev,nosuid"
ENV{ID_FS_TYPE}=="ofs|ffs|sfs|sfs2", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}="exec,noexec,nodev,nosuid,atime,noatime,nodiratime,relatime,strictatime,lazytime,ro,rw,sync,dirsync,nosymfollow"
ENV{ID_FS_TYPE}=="pfs3", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="ro,nodev,nosuid"
ENV{ID_FS_TYPE}=="pfs3", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}="exec,noexec,nodev,nosuid,atime,noatime,nodiratime,relatime,strictatime,lazytime,ro,sync,dirsync,nosymfollow"
