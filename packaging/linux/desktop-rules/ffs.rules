# Installed and removed only with the project-native ffs driver.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="ffs", ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition|disk", IMPORT{program}="/usr/bin/fsinspect --udev --filesystem ffs /dev/%k"
ENV{ID_FS_TYPE}=="ffs", RUN+="/sbin/modprobe -q ffs"
ENV{ID_FS_TYPE}=="ffs", ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="Amiga FFS"
ENV{ID_FS_TYPE}=="ffs", ENV{UDISKS_ICON_NAME}="drive-harddisk", ENV{UDISKS_SYMBOLIC_ICON_NAME}="drive-harddisk-symbolic"
ENV{ID_FS_TYPE}=="ffs", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="nodev,nosuid", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}="exec,noexec,nodev,nosuid,atime,noatime,nodiratime,relatime,strictatime,lazytime,ro,sync,dirsync,nosymfollow,rw"
