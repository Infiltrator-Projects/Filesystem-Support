From: Filesystem Support project
Subject: [PATCH] client: name the five native Amiga filesystem IDs

The detector already supplies the correct ID_FS_TYPE and ID_FS_VERSION.
GNOME Disks uses this client table for both its Contents field and volume
grid; UDISKS_NAME affects the device hint, not these filesystem descriptions.
Only display names change. Detection, mount policy and the library ABI remain
the distribution's implementations.

diff --git a/udisks/udisksclient.c b/udisks/udisksclient.c
--- a/udisks/udisksclient.c
+++ b/udisks/udisksclient.c
@@ -2044,5 +2044,15 @@ static const struct
   {"filesystem", "xfs",               "*",     NC_("fs-type", "XFS (version %s)"),                  NC_("fs-type", "XFS")},
   {"filesystem", "xfs",               NULL,    NC_("fs-type", "XFS"),                               NC_("fs-type", "XFS")},
+  {"filesystem", "ofs",               "*",     NC_("fs-type", "Amiga Original File System (%s)"),  NC_("fs-type", "Amiga OFS")},
+  {"filesystem", "ofs",               NULL,    NC_("fs-type", "Amiga Original File System"),       NC_("fs-type", "Amiga OFS")},
+  {"filesystem", "ffs",               "*",     NC_("fs-type", "Amiga Fast File System (%s)"),      NC_("fs-type", "Amiga FFS")},
+  {"filesystem", "ffs",               NULL,    NC_("fs-type", "Amiga Fast File System"),           NC_("fs-type", "Amiga FFS")},
+  {"filesystem", "sfs",               "*",     NC_("fs-type", "Amiga Smart File System (version %s)"), NC_("fs-type", "Amiga SFS")},
+  {"filesystem", "sfs",               NULL,    NC_("fs-type", "Amiga Smart File System"),          NC_("fs-type", "Amiga SFS")},
+  {"filesystem", "sfs2",              "*",     NC_("fs-type", "Amiga Smart File System 2 (version %s)"), NC_("fs-type", "Amiga SFS2")},
+  {"filesystem", "sfs2",              NULL,    NC_("fs-type", "Amiga Smart File System 2"),        NC_("fs-type", "Amiga SFS2")},
+  {"filesystem", "pfs3",              "*",     NC_("fs-type", "Amiga Professional File System 3 (%s)"), NC_("fs-type", "Amiga PFS3")},
+  {"filesystem", "pfs3",              NULL,    NC_("fs-type", "Amiga Professional File System 3"), NC_("fs-type", "Amiga PFS3")},
   /* TODO: No ID_FS_VERSION yet for btrfs... */
   {"filesystem", "btrfs",             NULL,    NC_("fs-type", "Btrfs"),                             NC_("fs-type", "Btrfs")},
   {"filesystem", "iso9660",           "*",     NC_("fs-type", "ISO 9660 (version %s)"),             NC_("fs-type", "ISO9660")},
